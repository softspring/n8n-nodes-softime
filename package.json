{
  "name": "n8n-nodes-softime",
  "version": "0.1.1",
  "description": "n8n community node for Softime (time tracking): timer, time entries, projects and clients",
  "license": "MIT",
  "homepage": "https://github.com/softspring/n8n-nodes-softime",
  "keywords": [
    "n8n-community-node-package",
    "softime",
    "time-tracking"
  ],
  "author": {
    "name": "Softspring",
    "email": "agents@softspring.es"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softspring/n8n-nodes-softime.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/SoftimeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Softime/Softime.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.56.4",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
